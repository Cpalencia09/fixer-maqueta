rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: existe un documento admins/{su uid} (se crea a mano en la consola).
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Participantes de una solicitud: el cliente que la creó y el técnico contratado.
    function enSolicitud(id) {
      let s = get(/databases/$(database)/documents/solicitudes/$(id)).data;
      return request.auth != null
          && (s.clienteId == request.auth.uid || s.get('tecnicoId', '') == request.auth.uid);
    }

    // Cada usuario solo puede comprobar si él mismo es admin. Nadie escribe aquí desde la app.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil de cada usuario: solo lo ve y edita su dueño.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil público del técnico: lo ve cualquier usuario con sesión.
    // El técnico lo crea como "pendiente" y no puede cambiar su propio estado.
    // Solo un administrador puede verificarlo o rechazarlo.
    match /tecnicos/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.estado == 'pendiente';
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.estado == resource.data.estado;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Datos sensibles del técnico (teléfono, cédula, documentos): su dueño y los administradores.
    match /tecnicos_privado/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Fotos de los documentos (cédula, selfie, certificado), una por documento.
    // El id es "{uid}_{documento}". Solo su dueño y los administradores pueden verlas.
    match /tecnicos_docs/{id} {
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && id == request.auth.uid + '_' + request.resource.data.k
                            && request.resource.data.k in ['ced', 'selfie', 'cert']
                            && request.resource.data.img is string
                            && request.resource.data.img.size() < 400000
                            && request.resource.data.img.matches('data:image/jpeg;base64,.*');
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Solicitudes: las ve el cliente que la creó y el técnico contratado.
    match /solicitudes/{id} {
      allow create: if request.auth != null && request.resource.data.clienteId == request.auth.uid;

      allow read: if request.auth != null && resource.data.clienteId == request.auth.uid;
      allow read: if request.auth != null && resource.data.tecnicoId == request.auth.uid;

      // El cliente puede actualizar su solicitud (liberar pago, calificar) sin cambiar de dueño.
      allow update: if request.auth != null
                    && resource.data.clienteId == request.auth.uid
                    && request.resource.data.clienteId == resource.data.clienteId;

      // El técnico solo puede cambiar el estado (aceptar, rechazar, terminar).
      allow update: if request.auth != null
                    && resource.data.tecnicoId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']);

      allow delete: if request.auth != null && resource.data.clienteId == request.auth.uid;

      // Chat de la solicitud: solo cliente y técnico, mensajes de hasta 500 caracteres.
      match /mensajes/{m} {
        allow read: if enSolicitud(id);
        allow create: if enSolicitud(id)
                      && request.resource.data.de == request.auth.uid
                      && request.resource.data.x is string
                      && request.resource.data.x.size() > 0
                      && request.resource.data.x.size() <= 500;
        allow delete: if enSolicitud(id);
      }
    }
  }
}
